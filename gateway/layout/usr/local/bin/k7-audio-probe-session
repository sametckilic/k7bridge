#!/bin/sh
set -eu

duration="${1:-45}"
case "$duration" in
    ''|*[!0-9]*) exit 64 ;;
esac
if [ "$duration" -lt 10 ] || [ "$duration" -gt 60 ]; then
    exit 64
fi

directory=/var/mobile/Library/K7Bridge
expires_at=$(($(date +%s) + duration))
printf '{"expiresAt":%s}\n' "$expires_at" > "$directory/audio-probe-session.json"
: > "$directory/audio-probe-result.jsonl"
